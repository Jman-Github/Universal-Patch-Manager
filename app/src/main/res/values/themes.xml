<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ReVancedManager" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <!-- Let Android 12+ draw the icon of the launcher alias that started this activity. -->
        <item name="android:windowSplashScreenAnimatedIcon">@null</item>
        <item name="postSplashScreenTheme">@style/Theme.AppCompat.NoActionBar</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
