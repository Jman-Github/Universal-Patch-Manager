<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/notification_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:maxLines="1" android:ellipsize="end" />
    <!-- Weighted zero-width text collapses inside wrap-content OEM notification templates. -->
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/notification_percentage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_marginStart="8dp" android:gravity="end" android:textDirection="locale" android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />
        <TextView android:id="@+id/notification_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_toStartOf="@id/notification_percentage" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2" android:maxLines="1" android:ellipsize="end" />
    </RelativeLayout>
    <ProgressBar
        android:id="@+id/notification_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="2dp"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/notification_progress_track"
        android:progressTint="@color/notification_progress_fill"
        android:progressBackgroundTint="@color/notification_progress_background"
        android:indeterminateTint="@color/notification_progress_fill" />
</LinearLayout>
